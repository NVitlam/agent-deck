    "test": "vitest run",
    "theater": "node esbuild.config.mjs --theater",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "vscode:prepublish": "node esbuild.config.mjs --production"
  },
