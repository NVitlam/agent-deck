    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.25.0",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^9.0.0",
    "jsdom": "^30.0.1",
    "svelte": "^5.56.9",
